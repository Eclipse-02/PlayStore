<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PlayStore" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/blue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/blue_on_primary_container</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorOnSecondary">@color/blue_on_secondary</item>

        <!-- TERTIARY -->
        <item name="colorTertiary">@color/blue_tertiary</item>
        <item name="colorOnTertiary">@color/blue_on_tertiary</item>

        <!-- SURFACE -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

        <!-- TEXT -->
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>

        <!-- OUTLINE -->
        <item name="colorOutline">@color/outline_light</item>

        <!-- RIPPLE -->
        <item name="rippleColor">@color/blue_primary</item>
        <item name="colorSecondaryContainer">@color/blue_ripple</item>
        <item name="colorOnSecondaryContainer">@color/blue_on_primary</item>

        <!-- STATUS BAR -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

</resources>