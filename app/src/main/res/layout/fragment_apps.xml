<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="@dimen/header_icon_size_main"
            android:layout_height="@dimen/header_icon_size_main"
            android:src="@drawable/gp_trans" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="@dimen/header_icon_size_secondary"
                android:layout_height="@dimen/header_icon_size_secondary"
                android:src="@drawable/notifications_20px" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/bg_badge_dot" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="@dimen/header_icon_size_main"
            android:layout_height="@dimen/header_icon_size_main"
            android:layout_marginStart="16dp"
            android:src="@drawable/user_main"
            app:shapeAppearanceOverlay="@style/RoundedImage" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSections"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>